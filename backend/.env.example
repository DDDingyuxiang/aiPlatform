# 复制为 .env 后填写本地值；.env 已被 .gitignore 忽略，禁止提交真实凭证。
NODE_ENV=development
PORT=3000

# 数据库密码；连接地址等非秘密配置见 config/database.yaml
DB_PASSWORD=replace-with-local-password

# JWT 签名密钥：至少 32 字符，生产环境必须由密钥管理系统注入
# 本地生成示例：openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_TTL_SECONDS=7200

# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173

# 业务时区（影响“本月考勤”等自然月边界）
APP_TIMEZONE=Asia/Shanghai

# 仅本地开发种子脚本使用
SEED_ADMIN_PASSWORD=change-me-123456
SEED_COMPANY_CODE=demo
SEED_COMPANY_NAME=演示企业

# 聊天附件本地存储目录（默认 backend/storage/uploads）
# CHAT_UPLOAD_DIR=/var/lib/aiplatform/uploads
# 单个聊天附件大小上限（字节，默认 20 MiB）
# CHAT_MAX_UPLOAD_BYTES=20971520

# Redis 密码；连接地址等非秘密配置见 config/redis.yaml
# REDIS_PASSWORD=
# 身份数据缓存 TTL（秒，默认 300）
# REDIS_CACHE_TTL_SECONDS=300

# 独立 AI 服务（Python + Ollama + BGE-M3）地址与超时
AI_SERVICE_URL=http://127.0.0.1:8000
AI_REQUEST_TIMEOUT_MS=180000

# 知识库原始文件存储目录（默认 backend/storage/knowledge）
# KNOWLEDGE_UPLOAD_DIR=/var/lib/aiplatform/knowledge
# KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
# KNOWLEDGE_SEARCH_LIMIT=6
# RAG 最低余弦相似度
# KNOWLEDGE_MIN_SCORE=0.4

# Qdrant 向量库；collection 维度必须与 embedding_profiles.dimension 一致
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_VECTOR_SIZE=1024
