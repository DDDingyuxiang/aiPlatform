{
  "name": "@aiplatform/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aiPlatform 业务后端（Express + TypeScript）",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aiplatform/contracts build && tsx watch src/server.ts",
    "worker": "pnpm --filter @aiplatform/contracts build && tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@aiplatform/contracts": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "mysql2": "^3.24.6",
    "ulid": "^3.0.2",
    "unpdf": "^1.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
