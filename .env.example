# ============================================================================
# Docker Compose 运行配置：复制为 .env 后修改（.env 已被 git 忽略）
# ============================================================================

# ---- 基础服务 ----
# 使用 openssl rand -hex 32 生成；生产环境至少 24 位
MYSQL_ROOT_PASSWORD=
# 后端/Worker 的受限账号密码；必须是 openssl rand -hex 32 生成的 64 位十六进制值
APP_DB_PASSWORD=
# 仅 docker-compose.dev.yml 调试时使用；默认部署不向宿主机发布数据服务端口
MYSQL_PORT=3307
REDIS_PORT=6380
# 唯一对外发布的前端端口；8080 被占用时可改为 8081 等
FRONTEND_PORT=8080
# 默认只允许本机访问；公网部署时让 HTTPS 反向代理连接该本机端口
FRONTEND_BIND_ADDRESS=127.0.0.1

# ---- 后端 ----
# 至少 32 个字符；本地可用 openssl rand -hex 32 生成
JWT_SECRET=
JWT_TTL_SECONDS=7200
CORS_ORIGINS=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai

# ---- 首次启动种子数据 ----
# 生产环境至少 16 位
SEED_ADMIN_PASSWORD=
# 至少 16 位，必须与 SEED_ADMIN_PASSWORD 分开生成
PLATFORM_SUPERADMIN_PASSWORD=
SEED_COMPANY_CODE=demo
SEED_COMPANY_NAME=演示企业

# ---- AI / Ollama ----
# 默认连接宿主机 Ollama。Linux 下需要让 Ollama 监听 0.0.0.0：
#   OLLAMA_HOST=0.0.0.0:11434 ollama serve
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-local:latest
OLLAMA_TIMEOUT_SECONDS=180
AI_REQUEST_TIMEOUT_MS=180000
# 关闭思考模型（qwen3 等）的 thinking 输出，显著降低首字延迟
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_TASK_NUM_PREDICT=256
OLLAMA_SUMMARY_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NO_THINK_FALLBACK=true

# 对话上下文预算与滚动摘要（后端读取）
AI_CONTEXT_MAX_TOKENS=6000
AI_CONTEXT_OVERHEAD_TOKENS=256
AI_CONTEXT_HISTORY_MESSAGES=32
AI_RAG_CONTEXT_CHARS=4000
AI_RAG_TIMEOUT_MS=3000
AI_SUMMARY_ENABLED=true
AI_SUMMARY_TRIGGER_TOKENS=2500
AI_SUMMARY_KEEP_RECENT_MESSAGES=8
AI_SUMMARY_MAX_CHARS=1200
AI_SUMMARY_TIMEOUT_MS=180000
AI_CONVERSATION_PAGE_SIZE=50
AI_STREAM_STALE_MS=300000
AI_STREAM_IDLE_TIMEOUT_MS=180000
AI_STREAM_TIMEOUT_MS=600000

# ---- 构建加速（可选） ----
# 国内环境可切换到 PyPI / npm 镜像
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com/

# ---- 知识库 / 向量检索 ----
# BGE-M3 ONNX 模型目录；容器内挂载为 /models/bge-m3
# 目录需包含 onnx/model.onnx、onnx/model.onnx_data、onnx/tokenizer.json
# 本地开发时改成宿主机真实路径，例如 /home/<user>/models/bge-m3
BGE_M3_MODEL_DIR=./models/bge-m3
# 仅 docker-compose.dev.yml 调试时使用
QDRANT_PORT=6335
QDRANT_VECTOR_SIZE=1024
QDRANT_COLLECTION=document_chunks
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_SEARCH_LIMIT=6
# RAG 最低余弦相似度；低于该值的检索结果不会进入 AI 上下文
KNOWLEDGE_MIN_SCORE=0.4
# 旧版本向量可能占据召回名额，检索时按倍数多召回再过滤
KNOWLEDGE_SEARCH_OVERFETCH=3

# 使用 docker-compose.ollama.yml（容器化 Ollama）时，模型必须来自 Ollama 仓库
# OLLAMA_DOCKER_MODEL=qwen3:4b
