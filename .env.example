# ============================================================================
# Docker Compose 运行配置：复制为 .env 后修改（.env 已被 git 忽略）
# ============================================================================

# ---- 基础服务 ----
MYSQL_ROOT_PASSWORD=change-me-strong-password
# 仅 docker-compose.dev.yml 调试时使用；默认部署不向宿主机发布数据服务端口
MYSQL_PORT=3307
REDIS_PORT=6380
# 唯一对外发布的前端端口；8080 被占用时可改为 8081 等
FRONTEND_PORT=8080

# ---- 后端 ----
# 至少 32 个字符；本地可用 openssl rand -hex 32 生成
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_TTL_SECONDS=7200
CORS_ORIGINS=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai

# ---- 首次启动种子数据 ----
SEED_ADMIN_PASSWORD=change-me-123456
SEED_COMPANY_CODE=demo
SEED_COMPANY_NAME=演示企业

# ---- AI / Ollama ----
# 默认连接宿主机 Ollama。Linux 下需要让 Ollama 监听 0.0.0.0：
#   OLLAMA_HOST=0.0.0.0:11434 ollama serve
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-local:latest
OLLAMA_TIMEOUT_SECONDS=180
AI_REQUEST_TIMEOUT_MS=180000

# ---- 构建加速（可选） ----
# 国内环境可切换到 PyPI / npm 镜像
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com/

# ---- 知识库 / 向量检索 ----
# BGE-M3 ONNX 模型目录；容器内挂载为 /models/bge-m3
# 目录需包含 onnx/model.onnx、onnx/model.onnx_data、onnx/tokenizer.json
# 本地开发时改成宿主机真实路径，例如 /home/<user>/models/bge-m3
BGE_M3_MODEL_DIR=./models/bge-m3
# 仅 docker-compose.dev.yml 调试时使用
QDRANT_PORT=6335
QDRANT_VECTOR_SIZE=1024
QDRANT_COLLECTION=document_chunks
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_SEARCH_LIMIT=6
# RAG 最低余弦相似度；低于该值的检索结果不会进入 AI 上下文
KNOWLEDGE_MIN_SCORE=0.4

# 使用 docker-compose.ollama.yml（容器化 Ollama）时，模型必须来自 Ollama 仓库
# OLLAMA_DOCKER_MODEL=qwen3:4b
