{
  "name": "aiplatform",
  "version": "0.1.0",
  "private": true,
  "description": "aiPlatform 企业级 AI 智能工作流平台",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "contracts:build": "pnpm --filter @aiplatform/contracts build",
